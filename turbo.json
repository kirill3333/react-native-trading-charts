{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml",
    ".yarn/releases/**",
    ".yarn/patches/**",
    "yarn.lock",
    "package.json",
    "src/**",
    "cpp/**",
    ".github/actions/**/action.yml",
    ".github/workflows/ci.yml"
  ],
  "globalEnv": ["NODE_ENV", "ImageOS", "ImageVersion", "RUNNER_ARCH"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "JAVA_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!ios/**",
        "!Gemfile*",
        "!.bundle/**",
        "$TURBO_ROOT$/android/src/**",
        "$TURBO_ROOT$/android/CMakeLists.txt",
        "$TURBO_ROOT$/android/*.gradle*",
        "$TURBO_ROOT$/android/gradle.properties",
        "$TURBO_ROOT$/android/gradle/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "MD_APPLE_SDK_ROOT",
        "DEVELOPER_DIR",
        "USE_FRAMEWORKS",
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!android/**",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/build/**",
        "!$TURBO_ROOT$/ios/generated/**"
      ],
      "outputs": []
    }
  }
}
